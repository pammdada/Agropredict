# Database
# Empty → embedded Postgres (PGlite) stored in ./.data/pglite
# Supabase / any Postgres → postgres://user:password@host:5432/postgres
DATABASE_URL=

# Password for the demo accounts created by the seed (default: AgroDemo2026)
SEED_PASSWORD=

# Set to "false" to skip the automatic demo seed on an empty database
AUTO_SEED=true

# HMAC secret used to sign simulated payment webhooks
PAYMENTS_WEBHOOK_SECRET=change-me-in-each-environment
